<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="snippet_chatbot" name="Chatbot Snippet" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']" position="inside">
            <div class="o_panel_body">
                <t t-snippet="website_custom_chatbot.s_chatbot"
                   t-thumbnail="/website_custom_chatbot/static/src/img/chatbot_thumbnail.png"/>
            </div>
        </xpath>
    </template>

    <template id="s_chatbot" name="Chatbot">
        <section class="s_chatbot">
            <div class="container">
                <div class="chatbot-wrapper">
                    <!-- Minimized Chatbot Button -->
                    <button class="chatbot-toggle">
                        <img src="/website_custom_chatbot/static/images/chatbot_icon.png" alt="Chatbot Icon"/>
                    </button>

                    <!-- Chatbot Container -->
                    <div class="chatbot-container hidden">
                        <div class="chat-header">
                            <span class="status">Craft-Chatbot</span>
                            <button class="close-chatbot">×</button>
                        </div>
                        <div class="chat-window">
                            <!-- Chat window starts empty; messages will be added dynamically -->
                        </div>
                        <div class="chat-input">
                            <form class="chat-form">
                                <input type="text" class="chat-query" placeholder="Ask a question"/>
                                <button type="submit" class="submit-btn">
                                    <span class="submit-icon">→</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>