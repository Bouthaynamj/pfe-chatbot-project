<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="snippet_chatbot" name="Chatbot Snippet" inherit_id="website.snippets">
        <xpath expr="//div[@id='snippet_structure']" position="inside">
            <div class="o_panel_body">
                <t t-snippet="website_custom_chatbot.s_chatbot"
                   t-thumbnail="/website_custom_chatbot/static/images/chatbot_icon.png"
                   t-options="website_custom_chatbot.ChatbotOptions"/>
            </div>
        </xpath>
    </template>

    <template id="s_chatbot" name="Chatbot">
        <section class="s_chatbot py-5">
            <div class="container">
                <div class="chatbot-wrapper position-fixed" style="bottom: 20px; right: 20px; z-index: 1050;">
                    <!-- Chatbot Toggle Button -->
                    <button class="chatbot-toggle btn btn-primary rounded-circle shadow d-flex justify-content-center align-items-center"
                            style="width: 60px; height: 60px;">
                        <i class="fa fa-comments" aria-hidden="true"></i>
                    </button>

                    <!-- Chatbot Container -->
                    <div class="chatbot-container card shadow-lg border-0 d-flex flex-column hidden"
                         style="width: 360px; height: 520px; position: absolute; bottom: 80px; right: 0;">
                        <!-- Chat Header -->
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Chatbot</span>
                            <div class="d-flex gap-2">
                                <button class="close-chatbot btn btn-sm btn-link text-white p-0"><i class="fa fa-times"></i></button>
                            </div>
                        </div>

                        <!-- Chat Window -->
                        <div class="chat-window flex-grow-1 overflow-auto p-3 bg-light">
                            
                        </div>

                        <!-- Chat Input -->
                        <div class="card-footer bg-white border-top p-3">
                            <form class="chat-form d-flex align-items-center">
                                <input type="text" class="chat-query form-control rounded-pill me-2" placeholder="Ask a question" />
                                <button type="submit" class="btn btn-primary rounded-circle d-flex justify-content-center align-items-center"
                                        style="width: 48px; height: 48px;">
                                    <i class="fa fa-paper-plane text-white"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>